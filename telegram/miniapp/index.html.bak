      /** ?�협 ???��??�택 ??POST /api/action threaten (비처??; threatRequestInFlight??confirmThreat?�서 ?�설??*/
      function postThreaten(targetKey) {
        if (isGameOver) {
          threatRequestInFlight = false;
          updateThreatConfirmEnabled();
          return;
        }
        var userTurnLockSeq = beginCaptainUserActionLock();
        var playerId = getPlayerId();
        logMiniappApiLang('/api/action');
        fetch(API_BASE + '/api/action', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ playerId: playerId, action: 'threaten', target: targetKey, lang: getLangForApi() })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.ok) {
              var st = { remaining_sec: data.remaining_sec, game_state: data.match_state };
              if (data.actual_imposter) st.actual_imposter = data.actual_imposter;
              if (data.is_timeout) st.is_timeout = data.is_timeout;
              updateStatus(st, { forApiMessage: true });
              if (data.game_over) stopStatePolling();
              appendSummaryOrEvents(data);
            } else {
              appendLog('Error: ' + (data.error || 'unknown'), true);
            }
          })
          .catch(function(err) {
            appendLog('Connection failed: ' + err.message, true);
          })
          .finally(function() {
            threatRequestInFlight = false;
            updateThreatConfirmEnabled();
            scheduleTryReleaseUserActionAfterLogRender(userTurnLockSeq);
          });
      }

      renderIntroScreen();

      introLangKo.addEventListener('click', function() {
        lang = 'ko';
        localStorage.setItem(LANG_KEY, lang);
        renderIntroScreen();
      });
      introLangEn.addEventListener('click', function() {
        lang = 'en';
        localStorage.setItem(LANG_KEY, lang);
        renderIntroScreen();
      });

      introInitBtn.addEventListener('click', function() {
        screen = 'game';
        if (introScreen) introScreen.classList.add('hidden');
        if (gameScreen) gameScreen.classList.add('visible');
        renderGameLabels();
        startGameBriefingScroll();
        doStart(false);
      });

      var executeModal = document.getElementById('execute-modal');
      var threatModal = document.getElementById('threat-modal');

      /** 처형 ?�정 ?�일 진입????/api/accuse (confirm 버튼·모달 ?�임�????�수 ?�출) */
      function confirmAccuse() {
        if (accuseRequestInFlight || userActionPending) return;
        var targetKey = selectedExecuteTarget;
        if (!targetKey || VALID_ACCUSE_TARGETS.indexOf(targetKey) < 0) {
          var sel = executeModal ? executeModal.querySelector('.modal-target-btn.selected') : null;
          targetKey = sel ? String(sel.getAttribute('data-target') || '').toLowerCase() : '';
        }
        if (!targetKey || VALID_ACCUSE_TARGETS.indexOf(targetKey) < 0) {
          var warn = document.getElementById('execute-no-target-hint');
          if (warn) {
            warn.textContent = (getL().executeNoTargetHint || '').trim();
            warn.classList.add('visible');
          }
          return;
        }
        if (isRoleDead(targetKey)) {
          selectedExecuteTarget = null;
          document.querySelectorAll('.modal-target-btn').forEach(function(b) { b.classList.remove('selected'); });
          updateExecuteConfirmEnabled();
          return;
        }
        accuseRequestInFlight = true;
        setAccuseConfirmDisabled(true);
        var warnEl = document.getElementById('execute-no-target-hint');
        if (warnEl) warnEl.classList.remove('visible');
        if (freeInput) {
          freeInput.value = '';
          freeInput.blur();
        }
        closeExecuteModal();
        postAccuse(targetKey);
      }

      function openExecuteModal() {
        if (isGameOver || userActionPending) return;
        if (executeModalUnlockTimer) {
          clearTimeout(executeModalUnlockTimer);
          executeModalUnlockTimer = null;
        }
        document.body.classList.add('execute-modal-open');
        if (freeInput) freeInput.blur();
        selectedExecuteTarget = null;
        var L = getL();
        document.querySelectorAll('.modal-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        var hint = document.getElementById('execute-no-target-hint');
        if (hint) {
          hint.textContent = L.executeNoTargetHint || '';
          hint.classList.remove('visible');
        }
        if (executeModal) executeModal.classList.add('visible');
        applyDeadStateToModalButtons();
      }

      function closeExecuteModal() {
        if (executeModal) executeModal.classList.remove('visible');
        if (executeModalUnlockTimer) clearTimeout(executeModalUnlockTimer);
        executeModalUnlockTimer = setTimeout(function() {
          executeModalUnlockTimer = null;
          document.body.classList.remove('execute-modal-open');
        }, 200);
      }

      function confirmThreat() {
        if (threatRequestInFlight || userActionPending) return;
        var targetKey = selectedThreatTarget;
        if (!targetKey || VALID_ACCUSE_TARGETS.indexOf(targetKey) < 0) {
          var sel = threatModal ? threatModal.querySelector('.threat-target-btn.selected') : null;
          targetKey = sel ? String(sel.getAttribute('data-target') || '').toLowerCase() : '';
        }
        if (!targetKey || VALID_ACCUSE_TARGETS.indexOf(targetKey) < 0) {
          var w = document.getElementById('threat-no-target-hint');
          if (w) {
            w.textContent = (getL().threatNoTargetHint || '').trim();
            w.classList.add('visible');
          }
          return;
        }
        if (isRoleDead(targetKey)) {
          selectedThreatTarget = null;
          if (threatModal) threatModal.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
          updateThreatConfirmEnabled();
          return;
        }
        threatRequestInFlight = true;
        if (threatConfirmBtn) threatConfirmBtn.disabled = true;
        var wh = document.getElementById('threat-no-target-hint');
        if (wh) wh.classList.remove('visible');
        if (freeInput) {
          freeInput.value = '';
          freeInput.blur();
        }
        closeThreatModal();
        postThreaten(targetKey);
      }

      function openThreatModal() {
        if (isGameOver || userActionPending) return;
        if (threatModalUnlockTimer) {
          clearTimeout(threatModalUnlockTimer);
          threatModalUnlockTimer = null;
        }
        document.body.classList.add('threat-modal-open');
        if (freeInput) freeInput.blur();
        selectedThreatTarget = null;
        var L = getL();
        if (threatModal) threatModal.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        var th = document.getElementById('threat-no-target-hint');
        if (th) {
          th.textContent = L.threatNoTargetHint || '';
          th.classList.remove('visible');
        }
        if (threatModal) threatModal.classList.add('visible');
        applyDeadStateToModalButtons();
      }

      function closeThreatModal() {
        if (threatModal) threatModal.classList.remove('visible');
        if (threatModalUnlockTimer) clearTimeout(threatModalUnlockTimer);
        threatModalUnlockTimer = setTimeout(function() {
          threatModalUnlockTimer = null;
          document.body.classList.remove('threat-modal-open');
        }, 200);
        selectedThreatTarget = null;
        if (threatModal) threatModal.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        if (threatConfirmBtn) threatConfirmBtn.disabled = true;
      }

      function buildQuestionMessageForRole(roleKey) {
        var L = getL();
        var rk = String(roleKey || '').toLowerCase();
        var name = L[rk] || rk;
        if (lang === 'ko') {
          return name + ', 그때 ?�디 ?�었지?';
        }
        return name + ', where were you then?';
      }

      function openQuestionModal() {
        if (isGameOver || userActionPending) return;
        if (questionModalUnlockTimer) {
          clearTimeout(questionModalUnlockTimer);
          questionModalUnlockTimer = null;
        }
        document.body.classList.add('question-modal-open');
        if (freeInput) freeInput.blur();
        selectedQuestionTarget = null;
        var L = getL();
        document.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        var qh = document.getElementById('question-no-target-hint');
        if (qh) {
          qh.textContent = L.questionNoTargetHint || '';
          qh.classList.remove('visible');
        }
        if (questionModal) questionModal.classList.add('visible');
        applyDeadStateToModalButtons();
      }

      function closeQuestionModal() {
        if (questionModal) questionModal.classList.remove('visible');
        if (questionModalUnlockTimer) clearTimeout(questionModalUnlockTimer);
        questionModalUnlockTimer = setTimeout(function() {
          questionModalUnlockTimer = null;
          document.body.classList.remove('question-modal-open');
        }, 200);
        selectedQuestionTarget = null;
        document.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        if (questionConfirmBtn) questionConfirmBtn.disabled = true;
        updateQuestionConfirmEnabled();
      }

      function confirmQuestion() {
        if (userActionPending || isGameOver) return;
        var sel = questionModal ? questionModal.querySelector('.question-target-btn.selected') : null;
        var targetKey = sel ? String(sel.getAttribute('data-target') || '').toLowerCase() : '';
        if (!targetKey || VALID_ACCUSE_TARGETS.indexOf(targetKey) < 0) {
          var w = document.getElementById('question-no-target-hint');
          if (w) {
            w.textContent = (getL().questionNoTargetHint || '').trim();
            w.classList.add('visible');
          }
          return;
        }
        if (isRoleDead(targetKey)) {
          selectedQuestionTarget = null;
          if (questionModal) questionModal.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
          updateQuestionConfirmEnabled();
          return;
        }
        console.log('[miniapp] question target=' + targetKey);
        var msg = buildQuestionMessageForRole(targetKey);
        if (freeInput) {
          freeInput.value = '';
          freeInput.blur();
        }
        closeQuestionModal();
        doMessage(msg);
      }

      document.querySelectorAll('.modal-target-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (userActionPending || this.disabled || this.classList.contains('dead')) return;
          var rid = String(this.getAttribute('data-target') || '').toLowerCase();
          if (isRoleDead(rid)) return;
          selectedExecuteTarget = VALID_ACCUSE_TARGETS.indexOf(rid) >= 0 ? rid : null;
          document.querySelectorAll('.modal-target-btn').forEach(function(b) { b.classList.remove('selected'); });
          this.classList.add('selected');
          var w = document.getElementById('execute-no-target-hint');
          if (w) w.classList.remove('visible');
          updateExecuteConfirmEnabled();
        });
      });

      if (executeModal) {
        executeModal.addEventListener('click', function(e) {
          var t = e.target;
          var confirmEl = t && t.closest ? t.closest('#execute-confirm') : (t && t.id === 'execute-confirm' ? t : null);
          if (confirmEl) {
            e.preventDefault();
            e.stopPropagation();
            if (userActionPending) return;
            confirmAccuse();
            return;
          }
          var cancelEl = t && t.closest ? t.closest('#execute-cancel') : (t && t.id === 'execute-cancel' ? t : null);
          if (cancelEl) {
            e.preventDefault();
            e.stopPropagation();
            closeExecuteModal();
            return;
          }
          if (e.target === executeModal) closeExecuteModal();
        });
      }

      if (threatModal) {
        threatModal.querySelectorAll('.threat-target-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            if (userActionPending || this.disabled || this.classList.contains('dead')) return;
            var rid = String(this.getAttribute('data-target') || '').toLowerCase();
            if (isRoleDead(rid)) return;
            selectedThreatTarget = VALID_ACCUSE_TARGETS.indexOf(rid) >= 0 ? rid : null;
            threatModal.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
            this.classList.add('selected');
            var hw = document.getElementById('threat-no-target-hint');
            if (hw) hw.classList.remove('visible');
            updateThreatConfirmEnabled();
          });
        });
        threatModal.addEventListener('click', function(e) {
          var t = e.target;
          var confirmEl = t && t.closest ? t.closest('#threat-confirm') : (t && t.id === 'threat-confirm' ? t : null);
          if (confirmEl) {
            e.preventDefault();
            e.stopPropagation();
            if (userActionPending) return;
            confirmThreat();
            return;
          }
          var cancelEl = t && t.closest ? t.closest('#threat-cancel') : (t && t.id === 'threat-cancel' ? t : null);
          if (cancelEl) {
            e.preventDefault();
            e.stopPropagation();
            closeThreatModal();
            return;
          }
          if (e.target === threatModal) closeThreatModal();
        });
      }

      if (questionModal) {
        questionModal.querySelectorAll('.question-target-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            if (userActionPending || this.disabled || this.classList.contains('dead')) return;
            var rid = String(this.getAttribute('data-target') || '').toLowerCase();
            if (isRoleDead(rid)) return;
            selectedQuestionTarget = VALID_ACCUSE_TARGETS.indexOf(rid) >= 0 ? rid : null;
            questionModal.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
            this.classList.add('selected');
            var qw = document.getElementById('question-no-target-hint');
            if (qw) qw.classList.remove('visible');
            updateQuestionConfirmEnabled();
          });
        });
        questionModal.addEventListener('click', function(e) {
          var t = e.target;
          var confirmEl = t && t.closest ? t.closest('#question-confirm') : (t && t.id === 'question-confirm' ? t : null);
          if (confirmEl) {
            e.preventDefault();
            e.stopPropagation();
            if (userActionPending) return;
            confirmQuestion();
            return;
          }
          var cancelEl = t && t.closest ? t.closest('#question-cancel') : (t && t.id === 'question-cancel' ? t : null);
          if (cancelEl) {
            e.preventDefault();
            e.stopPropagation();
            closeQuestionModal();
            return;
          }
          if (e.target === questionModal) closeQuestionModal();
        });
      }

      sendBtn.addEventListener('click', function() {
        if (isGameOver || userActionPending) return;
        var text = (freeInput.value || '').trim();
        if (!text) return;
        doMessage(text);
        freeInput.value = '';
      });

      freeInput.addEventListener('keydown', function(e) {
        if (e.key !== 'Enter') return;
        if (isGameOver || userActionPending) {
          e.preventDefault();
          return;
        }
        sendBtn.click();
      });

      actionBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (isGameOver || userActionPending) return;
          var action = this.dataset.action || '';
          if (action === 'question') {
            openQuestionModal();
          } else if (action === 'cctv') {
            doMessage(lang === 'ko' ? 'CCTV 로그�??�인?�다.' : 'Checking CCTV logs.');
          } else if (action === 'engine') {
            doMessage(lang === 'ko' ? '?�진??로그�??�인?�다.' : 'Checking engine room logs.');
          } else if (action === 'pistol') {
            postTakePistol();
          } else if (action === 'clue') {
            postCollectClue();
          } else if (action === 'threat') {
            openThreatModal();
          } else if (action === 'execute') {
            openExecuteModal();
          } else {
            console.log('[Tartarus MiniApp] action:', action);
          }
        });
      });

      function doRestart() {
        if (!isGameOver || startRequestInFlight) return;
        forceInvalidateUserActionLock();
        stopStatePolling();
        clearGameLogPanelAndState();
        previousGameOver = false;
        previousOutcome = null;
        resetResultUI();
        restartSection.classList.remove('visible');
        startGameBriefingScroll();
        doStart(true);
      }

      function onRestartClick(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        doRestart();
      }
      if (restartBtn) restartBtn.addEventListener('click', onRestartClick);
      if (resultRestartBtn) resultRestartBtn.addEventListener('click', onRestartClick);

      var resultModalEl = document.getElementById('result-modal');
      if (resultModalEl) resultModalEl.addEventListener('click', function(e) {
        if (e.target === resultModalEl) closeResultModal();
      });

      episodeUnlockBtn.addEventListener('click', function() {
        console.log('[Tartarus MiniApp] Unlock Episode Pass (placeholder)');
      });
    })();
  </script>
</body>
</html>
