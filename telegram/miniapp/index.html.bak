      const briefingObj1 = document.getElementById('briefing-obj-1');
      const briefingObj2 = document.getElementById('briefing-obj-2');
      const briefingObj3 = document.getElementById('briefing-obj-3');
      const gameBriefingViewport = document.getElementById('game-briefing-viewport');
      const gameBriefingScroll = document.getElementById('game-briefing-scroll');
      const statusMatchId = document.getElementById('status-match-id');
      const statusTime = document.getElementById('status-time');
      const statusLocation = document.getElementById('status-location');
      const statusThreat = document.getElementById('status-threat');
      const statusOutcomeWrap = document.getElementById('status-outcome-wrap');
      const statusOutcome = document.getElementById('status-outcome');
      const statusDeadWrap = document.getElementById('status-dead-wrap');
      const statusDead = document.getElementById('status-dead');
      const outcomeBadge = document.getElementById('outcome-badge');
      const logPanel = document.getElementById('log-panel');
      const logInit = document.getElementById('log-init');
      const freeInput = document.getElementById('free-input');
      const sendBtn = document.getElementById('send-btn');
      const inputArea = document.getElementById('input-area');
      const actionPanel = document.getElementById('action-panel');
      const actionBtns = document.querySelectorAll('.action-btn');
      var pistolActionBtn = actionPanel ? actionPanel.querySelector('.action-btn[data-action="pistol"]') : null;
      var clueActionBtn = actionPanel ? actionPanel.querySelector('.action-btn[data-action="clue"]') : null;
      const episodeUnlockBtn = document.getElementById('episode-unlock-btn');
      const restartSection = document.getElementById('restart-section');
      const restartBtn = document.getElementById('restart-btn');
      const resultRestartBtn = document.getElementById('result-restart-btn');
      const executeConfirmBtn = document.getElementById('execute-confirm');
      const threatConfirmBtn = document.getElementById('threat-confirm');
      const questionModal = document.getElementById('question-modal');
      const questionConfirmBtn = document.getElementById('question-confirm');
      const captainPhaseStatusEl = document.getElementById('captain-phase-status');

      var isGameOver = false;
      var previousGameOver = false;
      var previousOutcome = null;
      var executeModalUnlockTimer = null;
      /** ?�속 ?�일 로그 방�? (summary + recent_events ?�중 출력 ?? */
      var lastAppendedLogNorm = null;
      var startRequestInFlight = false;
      var accuseRequestInFlight = false;
      var takePistolRequestInFlight = false;
      var collectClueRequestInFlight = false;
      var threatRequestInFlight = false;
      var threatModalUnlockTimer = null;
      var questionModalUnlockTimer = null;
      var selectedThreatTarget = null;
      var selectedExecuteTarget = null;
      var selectedQuestionTarget = null;
      /** ?�재 매치???�망 ??�� ??updateStatus(game_state.dead_roles)?�서 갱신 */
      var lastDeadRoles = [];
      /** [?�장] �??�후 같�? ?�의 ?�루 반응 append ??�??�래�??�크롤하지 ?�음 */
      var logInActiveTurn = false;
      /** 직전 [??��]/System:/?�장?��??�더 ?�후 ?�레?�션 줄이 같�? ?�을 ?�어받기 ?�한 ??*/
      var lastLogBlockRole = null;
      /**
       * ?�장??직접 ?�작?????�청(/api/message, /api/action)?�만 true.
       * /api/state ?�링·백그?�운???�기?�는 ???�래그�? ?��? 켜거???��? ?�음(updateStatus fromPoll ?�용 경로).
       */
      var userActionPending = false;
      /** ?�금???��? ?�청???�퀀?? ??�� ?�착???�답??idle 콜백?� 불일�???무시 */
      var captainUserActionSeq = 0;
      var captainUserActionLockSeq = null;

      function refreshCaptainPhaseStatusUi() {
        if (!captainPhaseStatusEl) return;
        var L = getL();
        if (isGameOver) {
          captainPhaseStatusEl.textContent = '';
          captainPhaseStatusEl.classList.add('captain-phase-hidden');
          captainPhaseStatusEl.classList.remove('captain-phase-idle', 'captain-phase-pending');
          return;
        }
        captainPhaseStatusEl.classList.remove('captain-phase-hidden');
        if (userActionPending) {
          captainPhaseStatusEl.textContent = L.statusCrewPending || '';
          captainPhaseStatusEl.classList.remove('captain-phase-idle');
          captainPhaseStatusEl.classList.add('captain-phase-pending');
        } else {
          captainPhaseStatusEl.textContent = L.statusCaptainIdle || '';
          captainPhaseStatusEl.classList.remove('captain-phase-pending');
          captainPhaseStatusEl.classList.add('captain-phase-idle');
        }
      }

      function applyCaptainInputChrome() {
        var L = getL();
        var locked = isGameOver || userActionPending;
        document.body.classList.toggle('crew-response-pending', !!userActionPending && !isGameOver);
        if (inputArea) inputArea.classList.toggle('disabled', locked);
        if (freeInput) {
          freeInput.disabled = locked;
          if (isGameOver) freeInput.placeholder = L.gameOverPlaceholder;
          else if (userActionPending) freeInput.placeholder = L.statusInputLocked || L.statusCrewPending || '';
          else freeInput.placeholder = L.freeInput;
        }
        if (sendBtn) sendBtn.disabled = locked;
        actionBtns.forEach(function(b) {
          b.disabled = locked;
          b.classList.toggle('locked', locked);
        });
        if (episodeUnlockBtn) episodeUnlockBtn.disabled = locked;
      }

      /** rAF 미동???�레그램 WebView ?? ??idle 고착 방�???백업 ?�?�머 ???�용???�션 ?�료 콜백?�만 ?�결 */
      var captainIdleBackupTimer = null;

      function cancelCaptainIdleBackup() {
        if (captainIdleBackupTimer != null) {
          clearTimeout(captainIdleBackupTimer);
          captainIdleBackupTimer = null;
        }
      }

      function setUserActionPending(on) {
        if (on) cancelCaptainIdleBackup();
        userActionPending = !!on;
        if (!on) {
          cancelCaptainIdleBackup();
          captainUserActionLockSeq = null;
        }
        if (userActionPending) {
          if (executeModal && executeModal.classList.contains('visible')) closeExecuteModal();
          if (threatModal && threatModal.classList.contains('visible')) closeThreatModal();
          if (questionModal && questionModal.classList.contains('visible')) closeQuestionModal();
          if (freeInput) freeInput.blur();
        }
        applyCaptainInputChrome();
        refreshCaptainPhaseStatusUi();
        updateThreatConfirmEnabled();
        updateQuestionConfirmEnabled();
      }

      /** setPending: ?�직 ?�용?????�청 ?�작 ??*/
      function beginCaptainUserActionLock() {
        captainUserActionSeq++;
        var mySeq = captainUserActionSeq;
        captainUserActionLockSeq = mySeq;
        setUserActionPending(true);
        return mySeq;
      }

      function tryReleaseUserActionLockForSeq(lockSeq) {
        if (captainUserActionLockSeq === null || lockSeq !== captainUserActionLockSeq) return;
        setUserActionPending(false);
      }

      /**
       * ?�당 lockSeq ?�용???�청??로그 ?�기 append ?�후 idle (appendLog ?�크�?rAF ?�후).
       * ?�링·?�른 ?�청?� lockSeq�?바꾸지 ?�으므�??�기???�못 ?�제?��? ?�음.
       */
      function scheduleTryReleaseUserActionAfterLogRender(lockSeq) {
        cancelCaptainIdleBackup();
        captainIdleBackupTimer = setTimeout(function() {
          captainIdleBackupTimer = null;
          tryReleaseUserActionLockForSeq(lockSeq);
        }, 750);

        var finishIdle = function() {
          cancelCaptainIdleBackup();
          tryReleaseUserActionLockForSeq(lockSeq);
        };

        var afterPaint = function() {
          try {
            if (logPanel) void logPanel.offsetHeight;
          } catch (e) {}
          setTimeout(finishIdle, 0);
        };

        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              requestAnimationFrame(afterPaint);
            });
          });
        } else {
          setTimeout(afterPaint, 0);
        }
      }

      /** start/restart/game_over: ?��??�?�머·??? 콜백 무효????무조�?idle */
      function forceInvalidateUserActionLock() {
        cancelCaptainIdleBackup();
        captainUserActionSeq++;
        captainUserActionLockSeq = null;
        userActionPending = false;
        applyCaptainInputChrome();
        refreshCaptainPhaseStatusUi();
        updateThreatConfirmEnabled();
        updateQuestionConfirmEnabled();
      }

      function setRestartButtonsDisabled(disabled) {
        if (restartBtn) restartBtn.disabled = !!disabled;
        if (resultRestartBtn) resultRestartBtn.disabled = !!disabled;
      }

      function setAccuseConfirmDisabled(disabled) {
        if (executeConfirmBtn) executeConfirmBtn.disabled = !!disabled;
      }

      var statePollTimer = null;
      var statePollInFlight = false;

      function stopStatePolling() {
        if (statePollTimer != null) {
          clearInterval(statePollTimer);
          statePollTimer = null;
        }
      }

      function pollStateOnce() {
        if (screen !== 'game') return;
        if (statePollInFlight) return;
        statePollInFlight = true;
        var playerId = getPlayerId();
        fetch(API_BASE + '/api/state?playerId=' + encodeURIComponent(playerId) + '&lang=' + encodeURIComponent(getLangForApi()))
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (!data.ok) return;
            if (!data.match_id) {
              stopStatePolling();
              return;
            }
            var gs = data.game_state || {};
            var st = {
              match_id: data.match_id,
              remaining_sec: data.remaining_sec,
              game_state: gs
            };
            if (data.actual_imposter != null) st.actual_imposter = data.actual_imposter;
            if (data.is_timeout) st.is_timeout = data.is_timeout;
            /* 배경 ?�링: userActionPending·?�금 ?�퀀?�에 관?�하지 ?�음 */
            updateStatus(st, { forApiMessage: true, fromPoll: true });
            if (data.recent_events && data.recent_events.length) applyEvents(data.recent_events);
            if (gs.game_over) stopStatePolling();
          })
          .catch(function() { /* network noise: ignore */ })
          .finally(function() { statePollInFlight = false; });
      }

      function startStatePolling() {
        stopStatePolling();
        pollStateOnce();
        statePollTimer = setInterval(pollStateOnce, 2000);
      }

      function clearGameLogPanelAndState() {
        lastAppendedLogNorm = null;
        logInActiveTurn = false;
        lastLogBlockRole = null;
        if (logPanel) logPanel.innerHTML = '';
      }
      function resetResultUI() {
        forceInvalidateUserActionLock();
        accuseRequestInFlight = false;
        threatRequestInFlight = false;
        takePistolRequestInFlight = false;
        collectClueRequestInFlight = false;
        previousGameOver = false;
        previousOutcome = null;
        if (executeModalUnlockTimer) {
          clearTimeout(executeModalUnlockTimer);
          executeModalUnlockTimer = null;
        }
        if (threatModalUnlockTimer) {
          clearTimeout(threatModalUnlockTimer);
          threatModalUnlockTimer = null;
        }
        if (questionModalUnlockTimer) {
          clearTimeout(questionModalUnlockTimer);
          questionModalUnlockTimer = null;
        }
        document.body.classList.remove('execute-modal-open');
        document.body.classList.remove('threat-modal-open');
        document.body.classList.remove('question-modal-open');
        var execM = document.getElementById('execute-modal');
        if (execM) execM.classList.remove('visible');
        var threatM = document.getElementById('threat-modal');
        if (threatM) threatM.classList.remove('visible');
        if (questionModal) questionModal.classList.remove('visible');
        selectedThreatTarget = null;
        document.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        if (threatConfirmBtn) threatConfirmBtn.disabled = true;
        var threatNoTargetHintEl = document.getElementById('threat-no-target-hint');
        if (threatNoTargetHintEl) threatNoTargetHintEl.classList.remove('visible');
        selectedQuestionTarget = null;
        document.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        if (questionConfirmBtn) questionConfirmBtn.disabled = true;
        var questionNoTargetHintEl = document.getElementById('question-no-target-hint');
        if (questionNoTargetHintEl) questionNoTargetHintEl.classList.remove('visible');
        closeResultModal();
        var resultModal = document.getElementById('result-modal');
        if (resultModal) resultModal.classList.remove('result-win', 'result-lose');
        var resultTitle = document.getElementById('result-title');
        var resultDesc = document.getElementById('result-desc');
        var resultOutcomeRow = document.getElementById('result-outcome-row');
        var resultOutcomeValue = document.getElementById('result-outcome-value');
        var resultImposter = document.getElementById('result-imposter');
        var resultDead = document.getElementById('result-dead');
        if (resultTitle) resultTitle.textContent = '--';
        if (resultDesc) resultDesc.textContent = '--';
        if (resultOutcomeRow) resultOutcomeRow.style.display = 'none';
        if (resultOutcomeValue) resultOutcomeValue.textContent = '--';
        if (resultImposter) { resultImposter.textContent = ''; resultImposter.style.display = 'none'; }
        if (resultDead) { resultDead.innerHTML = ''; resultDead.style.display = 'none'; }
        if (outcomeBadge) {
          outcomeBadge.classList.remove('visible', 'crew_win', 'impostor_win', 'accuse_failed');
          outcomeBadge.textContent = '';
        }
        if (statusOutcomeWrap) statusOutcomeWrap.style.display = 'none';
        if (statusOutcome) statusOutcome.textContent = '--';
        selectedExecuteTarget = null;
        var targets = document.querySelectorAll('.modal-target-btn');
        if (targets.length) targets.forEach(function(b) { b.classList.remove('selected'); });
        var execNoTargetHint = document.getElementById('execute-no-target-hint');
        if (execNoTargetHint) execNoTargetHint.classList.remove('visible');
        updateExecuteConfirmEnabled();
        updateThreatConfirmEnabled();
        updateQuestionConfirmEnabled();
        applyCaptainInputChrome();
        refreshCaptainPhaseStatusUi();
      }

      function getPlayerId() {
        let id = localStorage.getItem(PLAYER_KEY);
        if (!id) {
          id = 'miniapp_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
          localStorage.setItem(PLAYER_KEY, id);
        }
        return id;
      }

      function formatTime(sec) {
        if (sec == null || sec < 0) return '--:--';
        var m = Math.floor(sec / 60);
        var s = Math.floor(sec % 60);
        return m + ':' + String(s).padStart(2, '0');
      }

      function truncateMatchId(id) {
        if (!id || id.length <= 20) return id;
        return id.slice(0, 10) + '...' + id.slice(-8);
      }

      function isLogNearBottom(el, slackPx) {
        if (!el) return true;
        slackPx = slackPx == null ? 80 : slackPx;
        return el.scrollHeight - el.scrollTop - el.clientHeight <= slackPx;
      }

      /** ?????�작: [?�장] / [Captain] ???�장 발화 �?�?*/
      function isCaptainTurnStartLine(s) {
        return /^\s*\[(?�장|Captain|CAPTAIN|captain)\]/i.test(String(s || '').trim());
      }

      /** Maps [?�장]/[Captain]/??inner tag to data-role key; null = default CRT green log line */
      function mapBracketInnerToLogRole(inner) {
        var key = String(inner || '').trim();
        var lower = key.toLowerCase();
        if (key === '?�장' || lower === 'captain') return 'captain';
        if (key === '?�터' || lower === 'doctor') return 'doctor';
        if (key === '?��??�어' || lower === 'engineer') return 'engineer';
        if (key === '?�비게이?? || lower === 'navigator') return 'navigator';
        if (key === '?�일?? || lower === 'pilot') return 'pilot';
        if (key === '?�스?? || lower === 'system') return 'system';
        return null;
      }

      /**
       * Parse a single log line for role coloring (game log only).
       * Bracket headers [??��] or leading "System:" ??data-role + header/body spans.
       */
      function parseLogLineForRoleDisplay(raw) {
        var s = String(raw || '');
        var trimmed = s.trim();
        var bm = trimmed.match(/^\[([^\]]+)\]([\s\S]*)$/);
        if (bm) {
          var role = mapBracketInnerToLogRole(bm[1]);
          if (role) {
            var rest = (bm[2] || '').replace(/^\s+/, '');
            return {
              role: role,
              headerText: '[' + bm[1] + ']',
              bodyText: rest,
              structured: true
            };
          }
        }
        var sm = trimmed.match(/^System\s*:\s*([\s\S]*)$/i);
        if (sm) {
          return {
            role: 'system',
            headerText: 'System:',
            bodyText: (sm[1] || '').replace(/^\s+/, ''),
            structured: true
          };
        }
        return { role: null, headerText: null, bodyText: s, structured: false };
      }

      /** ?�버 ?�약/?��? ??�??????�어받기 ?�커 ?�제 (기본 ?�색) */
      function isInternalActedSummaryLine(raw) {
        return /^(Captain acted\.?|Crew acted\.?|?�장???�동?�다\.?)$/i.test(String(raw || '').trim());
      }

      function isCaptainNarrationLineKo(raw) {
        return /^?�장??s/.test(String(raw || '').trim());
      }

      function scrollLogTurnAnchorIntoView(anchorEl) {
        if (!logPanel || !anchorEl || !logPanel.contains(anchorEl)) return;
        var apply = function() {
          var top = anchorEl.offsetTop;
          if (typeof logPanel.scrollTo === 'function') {
            logPanel.scrollTo({ top: top, behavior: 'auto' });
          } else {
            logPanel.scrollTop = top;
          }
        };
        if (typeof requestAnimationFrame === 'function') {
          requestAnimationFrame(apply);
        } else {
          setTimeout(apply, 0);
        }
      }

      function appendLog(text, isError) {
        var raw = String(text == null ? '' : text).replace(/\s+/g, ' ').trim();
        if (!raw || raw === '\u200b') return;
        if (raw === lastAppendedLogNorm) return;
        lastAppendedLogNorm = raw;
        if (logInit && logInit.parentNode) logInit.remove();
        var entry = document.createElement('div');
        entry.className = 'log-entry' + (isError ? ' error' : '');
        if (isError) {
          lastLogBlockRole = null;
          entry.textContent = raw;
          if (!logPanel) return;
          var wasFollowingErr = isLogNearBottom(logPanel);
          logPanel.appendChild(entry);
          if (wasFollowingErr) logPanel.scrollTop = logPanel.scrollHeight;
          return;
        }

        var parsed = parseLogLineForRoleDisplay(raw);
        var bracketProbe = raw.match(/^\[([^\]]+)\]/);
        if (bracketProbe && !mapBracketInnerToLogRole(bracketProbe[1])) {
          lastLogBlockRole = null;
          entry.textContent = raw;
        } else if (isInternalActedSummaryLine(raw)) {
          lastLogBlockRole = null;
          entry.textContent = raw;
        } else if (/^Game over\.?\s/i.test(raw)) {
          lastLogBlockRole = null;
          entry.textContent = raw;
        } else if (parsed.role) {
          lastLogBlockRole = parsed.role;
          entry.setAttribute('data-role', parsed.role);
          var head = document.createElement('span');
          head.className = 'log-role-header';
          head.textContent = parsed.headerText;
          entry.appendChild(head);
          if (parsed.bodyText) {
            entry.appendChild(document.createTextNode(' '));
            var body = document.createElement('span');
            body.className = 'log-role-body';
            body.textContent = parsed.bodyText;
            entry.appendChild(body);
          }
        } else if (isCaptainNarrationLineKo(raw)) {
          lastLogBlockRole = 'captain';
          entry.setAttribute('data-role', 'captain');
          entry.textContent = raw;
        } else if (lastLogBlockRole) {
          entry.setAttribute('data-role', lastLogBlockRole);
          entry.textContent = raw;
        } else {
          entry.textContent = raw;
        }
        if (!logPanel) return;
        var wasFollowing = isLogNearBottom(logPanel);
        logPanel.appendChild(entry);

        var isCaptain = isCaptainTurnStartLine(raw) && !isError;

        if (isCaptain) {
          entry.classList.add('log-turn-anchor');
          logInActiveTurn = true;
          if (wasFollowing) {
            scrollLogTurnAnchorIntoView(entry);
          }
        } else if (!logInActiveTurn && wasFollowing) {
          logPanel.scrollTop = logPanel.scrollHeight;
        }
      }

      function getL() { return GAME_LABELS[lang] || GAME_LABELS.en; }

      function normalizeDeadRoleKey(r) {
        return String(r || '').trim().toLowerCase();
      }
      function getDeadRolesSet() {
        var set = new Set();
        (lastDeadRoles || []).forEach(function(r) {
          var k = normalizeDeadRoleKey(r);
          if (k) set.add(k);
        });
        return set;
      }
      function isRoleDead(roleKey) {
        if (!roleKey) return false;
        return getDeadRolesSet().has(normalizeDeadRoleKey(roleKey));
      }
      function getTargetButtonLabel(roleKey, dead) {
        var L = getL();
        var base = L[roleKey] || roleKey;
        if (!dead) return base;
        var mark = L.resultDeadLabel || '?�망';
        return base + ' (' + mark + ')';
      }
      function updateExecuteConfirmEnabled() {
        if (!executeConfirmBtn) return;
        if (accuseRequestInFlight) {
          executeConfirmBtn.disabled = true;
          return;
        }
        var alive = selectedExecuteTarget && !isRoleDead(selectedExecuteTarget);
        executeConfirmBtn.disabled = !alive;
      }
      function updateThreatConfirmEnabled() {
        if (!threatConfirmBtn) return;
        if (threatRequestInFlight) {
          threatConfirmBtn.disabled = true;
          return;
        }
        var alive = selectedThreatTarget && !isRoleDead(selectedThreatTarget);
        threatConfirmBtn.disabled = !alive;
      }
      function updateQuestionConfirmEnabled() {
        if (!questionConfirmBtn) return;
        if (userActionPending) {
          questionConfirmBtn.disabled = true;
          return;
        }
        var sel = questionModal ? questionModal.querySelector('.question-target-btn.selected') : null;
        var rid = sel ? String(sel.getAttribute('data-target') || '').toLowerCase() : '';
        var alive = rid && VALID_ACCUSE_TARGETS.indexOf(rid) >= 0 && !isRoleDead(rid);
        questionConfirmBtn.disabled = !alive;
      }
      function applyDeadStateToModalButtons() {
        VALID_ACCUSE_TARGETS.forEach(function(r) {
          var dead = isRoleDead(r);
          var label = getTargetButtonLabel(r, dead);
          var execBtn = document.getElementById('target-' + r);
          var threatBtn = document.getElementById('threat-target-' + r);
          var qBtn = document.getElementById('question-target-' + r);
          [execBtn, threatBtn, qBtn].forEach(function(btn) {
            if (!btn) return;
            btn.textContent = label;
            btn.classList.toggle('dead', dead);
            btn.disabled = dead;
          });
        });
        if (selectedExecuteTarget && isRoleDead(selectedExecuteTarget)) {
          selectedExecuteTarget = null;
          document.querySelectorAll('.modal-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        }
        if (selectedThreatTarget && isRoleDead(selectedThreatTarget)) {
          selectedThreatTarget = null;
          document.querySelectorAll('.threat-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        }
        if (selectedQuestionTarget && isRoleDead(selectedQuestionTarget)) {
          selectedQuestionTarget = null;
          document.querySelectorAll('.question-target-btn').forEach(function(b) { b.classList.remove('selected'); });
        }
        updateExecuteConfirmEnabled();
        updateThreatConfirmEnabled();
        updateQuestionConfirmEnabled();
      }

      function syncLangFromStorage() {
        var stored;
        try { stored = (localStorage.getItem(LANG_KEY) || '').trim(); } catch (e) { stored = ''; }
        lang = (stored === 'ko' || stored === 'en') ? stored : 'en';
      }

      function restartIntroScrollAnimation() {
        if (!introScrollContent) return;
        introScrollContent.classList.remove('scroll-animate');
        void introScrollContent.offsetWidth;
        introScrollContent.classList.add('scroll-animate');
      }

      function setGameOverLock(locked) {
        isGameOver = !!locked;
        if (restartSection) restartSection.classList.toggle('visible', locked);
        applyCaptainInputChrome();
        refreshCaptainPhaseStatusUi();
      }

      function ensureIntroButtonsEnabled() {
        [introInitBtn, introLangKo, introLangEn].forEach(function(btn) {
          if (!btn) return;
          btn.disabled = false;
          btn.removeAttribute('disabled');
          btn.removeAttribute('aria-disabled');
          btn.classList.remove('locked', 'disabled');
        });
      }

      function renderIntroScreen() {
        syncLangFromStorage();
        ensureIntroButtonsEnabled();
        var lines = OPENING_LINES[lang] || OPENING_LINES.en;
        if (introScrollLines) {
          var html = '';
          for (var i = 0; i < lines.length; i++) {
            var ln = lines[i];
            if (ln === ' ') {
              html += '<div class="lore-line lore-spacer"></div>';
            } else if (/^\[?�데??경보\]|^\[HADES ALERT\]/.test(ln)) {
              html += '<div class="lore-line lore-alert">' + ln + '</div>';
            } else if (/^\[주요 목표\]|^\[PRIMARY OBJECTIVES\]/.test(ln)) {
              html += '<div class="lore-line lore-section-title">' + ln + '</div>';
            } else {
              html += '<div class="lore-line">' + ln + '</div>';
            }
          }
          introScrollLines.innerHTML = html;
        }
        if (introInitBtn) introInitBtn.textContent = (lang === 'ko') ? '[ ?�스??기동 ]' : '[ SYSTEM INITIALIZE ]';
        if (introLangKo) { introLangKo.classList.toggle('active', lang === 'ko'); introLangKo.textContent = '?�국??; }
        if (introLangEn) { introLangEn.classList.toggle('active', lang === 'en'); introLangEn.textContent = 'ENGLISH'; }
        restartIntroScrollAnimation();
      }

      function startGameBriefingScroll() {
        if (!gameBriefingViewport || !gameBriefingScroll) return;
        gameBriefingViewport.classList.remove('collapsed');
        gameBriefingScroll.classList.remove('scroll-animate');
        void gameBriefingScroll.offsetWidth;
        gameBriefingScroll.classList.add('scroll-animate');
        var onEnd = function() {
          gameBriefingScroll.removeEventListener('animationend', onEnd);
          if (gameBriefingViewport) gameBriefingViewport.classList.add('collapsed');
        };
        gameBriefingScroll.addEventListener('animationend', onEnd);
      }

      function renderGameLabels() {
        var L = getL();
        if (hudCountdown) hudCountdown.textContent = L.countdown + ' : ' + (statusTime && statusTime.textContent ? statusTime.textContent : '--:--');
        if (briefingBootTitle) briefingBootTitle.textContent = L.bootTitle;
        if (briefingTargetVessel) briefingTargetVessel.textContent = L.targetVessel;
        if (briefingMission) briefingMission.textContent = L.mission;
        if (briefingLocation) briefingLocation.textContent = L.briefingLocation;
        if (briefingHadesTitle) briefingHadesTitle.textContent = L.hadesTitle;
        if (briefingHades1) briefingHades1.textContent = L.hades1;
        if (briefingHades2) briefingHades2.textContent = L.hades2;
        if (briefingHades3) briefingHades3.textContent = L.hades3;
        if (briefingHades4) briefingHades4.textContent = L.hades4;
        if (briefingObjectivesTitle) briefingObjectivesTitle.textContent = L.objectivesTitle;
        if (briefingObj1) briefingObj1.textContent = L.obj1;
        if (briefingObj2) briefingObj2.textContent = L.obj2;
        if (briefingObj3) briefingObj3.textContent = L.obj3;
        var labels = { 'label-match-id': L.matchId, 'label-remaining': L.remaining, 'label-location': L.location, 'label-threat': L.threat, 'label-outcome': L.outcome, 'label-dead': L.deadRoles };
        for (var k in labels) { var el = document.getElementById(k); if (el) el.textContent = labels[k]; }
        actionBtns.forEach(function(b) {
          var a = b.dataset.action;
          if (a === 'question') b.textContent = L.question;
          else if (a === 'cctv') b.textContent = L.cctv;
          else if (a === 'engine') b.textContent = L.engine;
          else if (a === 'pistol') b.textContent = L.pistol;
          else if (a === 'threat') b.textContent = L.threatBtn;
          else if (a === 'clue') b.textContent = L.clue;
          else if (a === 'execute') b.textContent = L.execute;
        });
        if (freeInput) {
          if (isGameOver) freeInput.placeholder = L.gameOverPlaceholder;
          else if (userActionPending) freeInput.placeholder = L.statusInputLocked || L.statusCrewPending || '';
          else freeInput.placeholder = L.freeInput;
        }
        if (sendBtn) sendBtn.textContent = L.send;
        if (restartBtn) restartBtn.textContent = L.restart;
        if (resultRestartBtn) {
          resultRestartBtn.textContent = L.restart;
          if (!startRequestInFlight) resultRestartBtn.disabled = false;
        }
        var execTitle = document.getElementById('execute-modal-title');
        var execInst = document.getElementById('execute-modal-instruction');
        var execCancel = document.getElementById('execute-cancel');
        if (execTitle) execTitle.textContent = L.executeModalTitle;
        if (execInst) execInst.textContent = L.executeModalInstruction || '';
        if (execCancel) execCancel.textContent = L.cancel;
        if (executeConfirmBtn) {
          executeConfirmBtn.textContent = L.confirm;
          if (!accuseRequestInFlight) updateExecuteConfirmEnabled();
        }
        var execNoTarget = document.getElementById('execute-no-target-hint');
        if (execNoTarget) {
          execNoTarget.textContent = L.executeNoTargetHint || '';
          execNoTarget.classList.remove('visible');
        }
        applyDeadStateToModalButtons();
        var threatTitle = document.getElementById('threat-modal-title');
        var threatInst = document.getElementById('threat-modal-instruction');
        var threatCancel = document.getElementById('threat-cancel');
        if (threatTitle) threatTitle.textContent = L.threatModalTitle || '';
        if (threatInst) threatInst.textContent = L.threatModalInstruction || '';
        if (threatCancel) threatCancel.textContent = L.cancel;
        if (threatConfirmBtn) {
          threatConfirmBtn.textContent = L.confirm;
          if (!threatRequestInFlight) updateThreatConfirmEnabled();
        }
        var threatNoTarget = document.getElementById('threat-no-target-hint');
        if (threatNoTarget) {
          threatNoTarget.textContent = L.threatNoTargetHint || '';
          threatNoTarget.classList.remove('visible');
        }
        var qTitle = document.getElementById('question-modal-title');
        var qInst = document.getElementById('question-modal-instruction');
        var qCancel = document.getElementById('question-cancel');
        if (qTitle) qTitle.textContent = L.questionModalTitle || '';
        if (qInst) qInst.textContent = L.questionModalInstruction || '';
        if (qCancel) qCancel.textContent = L.cancel;
        if (questionConfirmBtn) {
          questionConfirmBtn.textContent = L.confirm;
          updateQuestionConfirmEnabled();
        }
        var qNoTarget = document.getElementById('question-no-target-hint');
        if (qNoTarget) {
          qNoTarget.textContent = L.questionNoTargetHint || '';
          qNoTarget.classList.remove('visible');
        }
        refreshCaptainPhaseStatusUi();
        applyCaptainInputChrome();
      }

      function formatOutcomeDisplay(outcome) {
        if (!outcome) return 'unknown';
        var map = { crew_win: 'crew_win', accuse_failed: 'accuse_failed', impostor_win: 'impostor_win', timeout: 'timeout' };
        return (map[outcome] || outcome).replace(/_/g, ' ').toUpperCase();
      }

      /** API actual_imposter가 ?�뢰 가?�한 ??�� ?�일 ?�만 결과 모달???�출 */
      function canonicalActualImposterRole(raw) {
        if (raw == null) return null;
        var s = String(raw).trim();
        if (!s) return null;
        var low = s.toLowerCase();
        if (low === 'unknown' || low === 'null' || low === 'undefined') return null;
        if (low === '(unknown)' || low === 'n/a' || low === 'none') return null;
        if (/(?�인\s*불�?)/.test(s)) return null;
        if (['doctor', 'engineer', 'navigator', 'pilot'].indexOf(low) >= 0) return low;
        return null;
      }

      function showResultModal(state) {
        var gs = state.game_state || {};
        var outcome = gs.outcome || 'unknown';
        var isTimeout = !!state.is_timeout;
        var actualImposter = state.actual_imposter;
        var deadRoles = gs.dead_roles || [];
        var L = getL();
        var resultModal = document.getElementById('result-modal');
        var resultTitle = document.getElementById('result-title');
        var resultDesc = document.getElementById('result-desc');
        var resultOutcomeRow = document.getElementById('result-outcome-row');
        var resultOutcomeLabel = document.getElementById('result-outcome-label');
        var resultOutcomeValue = document.getElementById('result-outcome-value');
        var resultImposter = document.getElementById('result-imposter');
        var resultDead = document.getElementById('result-dead');
        resultModal.classList.remove('result-win', 'result-lose');
        if (outcome === 'crew_win') {
          resultModal.classList.add('result-win');
          resultTitle.textContent = L.resultTitleWin;
          resultDesc.textContent = L.resultDescCrewWin;
        } else {
          resultModal.classList.add('result-lose');
          if (outcome === 'accuse_failed') {
            resultTitle.textContent = L.resultTitleLoseAccuse;
            resultDesc.textContent = L.resultDescAccuseFailed;
          } else if (isTimeout || outcome === 'timeout') {
            resultTitle.textContent = L.resultTitleLoseTimeout;
            resultDesc.textContent = L.resultDescTimeout;
          } else {
            resultTitle.textContent = L.resultTitleLoseImpostor;
            resultDesc.textContent = L.resultDescImpostorWin;
          }
        }

        if (resultOutcomeRow) {
          resultOutcomeLabel.textContent = (L.resultOutcomeLabel || 'Outcome') + ': ';
          resultOutcomeValue.textContent = formatOutcomeDisplay(outcome);
          resultOutcomeRow.style.display = 'block';
        }

        var imposterKey = canonicalActualImposterRole(actualImposter);
        if (imposterKey && resultImposter) {
          var roleLabel = L[imposterKey] || imposterKey;
          resultImposter.textContent = L.resultImposterPrefix + roleLabel;
          resultImposter.style.display = 'block';
        } else if (resultImposter) {
          resultImposter.textContent = '';
          resultImposter.style.display = 'none';
        }

        if (deadRoles.length > 0) {
          var deadLabels = deadRoles.map(function(r) { return L[r] || r; });
          resultDead.innerHTML = '<span class="result-dead-label">' + L.resultDeadLabel + ': </span>' + deadLabels.join(', ');
          resultDead.style.display = 'block';
        } else {
          resultDead.style.display = 'none';
        }

        if (resultRestartBtn) {
          resultRestartBtn.textContent = L.restart;
          if (!startRequestInFlight) resultRestartBtn.disabled = false;
        }
        if (resultModal) resultModal.classList.add('visible');
      }

      function closeResultModal() {
        var resultModal = document.getElementById('result-modal');
        if (resultModal) resultModal.classList.remove('visible');
      }

      function updateStatus(state, opts) {
        opts = opts || {};
        if (!state) return;
        /* opts.fromPoll === true ??/api/state 경로??userActionPending??켜거???��? ?�음(게임 ?�버 ??forceInvalidate�?. */
        var gs = state.game_state || {};
        lastDeadRoles = gs.dead_roles || [];
        var prevWasGameOver = previousGameOver;

        if (state.match_id) {
          var short = truncateMatchId(state.match_id);
          statusMatchId.textContent = short;
          statusMatchId.title = state.match_id;
        }
        var timeStr = formatTime(state.remaining_sec);
        statusTime.textContent = timeStr;
        statusLocation.textContent = state.location || 'Bridge';
        if (hudCountdown) hudCountdown.textContent = getL().countdown + ' : ' + timeStr;

        if (gs.game_over && gs.outcome) {
          forceInvalidateUserActionLock();
          statusThreat.textContent = 'GAME OVER';
          statusThreat.classList.remove('nominal');
          statusThreat.classList.add('threat');
          setGameOverLock(true);

          outcomeBadge.textContent = gs.outcome.toUpperCase().replace(/_/g, ' ');
          outcomeBadge.className = 'outcome-badge visible ' + (gs.outcome || '').replace(/-/g, '_');
          if (statusOutcomeWrap) { statusOutcomeWrap.style.display = 'block'; statusOutcome.textContent = gs.outcome; }

          /* /api/start 복원 ??fromStart) ?�는 /api/message ?�답 ??forApiMessage): game_over ?�환�?결과 모달 */
          var allowResultModal = opts.fromStart === true || opts.forApiMessage === true;
          if (!prevWasGameOver && allowResultModal) showResultModal(state);
        } else if (gs.game_over && !gs.outcome) {
          forceInvalidateUserActionLock();
          statusThreat.textContent = 'GAME OVER';
          statusThreat.classList.remove('nominal');
          statusThreat.classList.add('threat');
          setGameOverLock(true);
          outcomeBadge.classList.remove('visible', 'crew_win', 'impostor_win', 'accuse_failed');
          outcomeBadge.textContent = '';
          if (statusOutcomeWrap) statusOutcomeWrap.style.display = 'none';
          if (statusOutcome) statusOutcome.textContent = '--';
          closeResultModal();
        } else {
          statusThreat.textContent = (gs.dead_roles && gs.dead_roles.length > 0) ? 'ELEVATED' : 'NOMINAL';
          statusThreat.classList.toggle('threat', (gs.dead_roles && gs.dead_roles.length > 0));
          statusThreat.classList.toggle('nominal', !(gs.dead_roles && gs.dead_roles.length > 0));
          setGameOverLock(false);
          outcomeBadge.classList.remove('visible', 'crew_win', 'impostor_win', 'accuse_failed');
          outcomeBadge.textContent = '';
          if (statusOutcomeWrap) statusOutcomeWrap.style.display = 'none';
          if (statusOutcome) statusOutcome.textContent = '--';
          closeResultModal();
        }

        previousGameOver = !!gs.game_over;
        previousOutcome = gs.outcome || null;

        if (gs.dead_roles && gs.dead_roles.length > 0) {
          if (statusDeadWrap) { statusDeadWrap.style.display = 'block'; statusDead.textContent = gs.dead_roles.join(', '); statusDead.classList.add('threat'); }
        } else if (statusDeadWrap) { statusDeadWrap.style.display = 'none'; statusDead.classList.remove('threat'); }

        applyDeadStateToModalButtons();
      }

      function applyEvents(events) {
        if (!events || !events.length) return;
        events.forEach(function(ev) {
          var label = String((ev.type || ev.role || '') + (ev.target ? ' -> ' + ev.target : '')).trim();
          if (label) appendLog(label, false);
        });
      }

      function appendSummaryOrEvents(data) {
        if (data.recent_events && data.recent_events.length) {
          applyEvents(data.recent_events);
        } else {
          var fb = (getLangForApi() === 'ko') ? '?�장???�동?�다.' : 'Captain acted.';
          var s = String(data.summary || fb).replace(/\s+/g, ' ').trim();
          if (s && s !== '\u200b') appendLog(s, false);
        }
      }

      function doStart(restart) {
        if (startRequestInFlight) return;
        forceInvalidateUserActionLock();
        startRequestInFlight = true;
        setRestartButtonsDisabled(true);
        var playerId = getPlayerId();
        logMiniappApiLang('/api/start');
        fetch(API_BASE + '/api/start', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ playerId: playerId, restart: !!restart, lang: getLangForApi() })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.ok) {
              resetResultUI();
              ensureIntroButtonsEnabled();
              var st = { match_id: data.match_id, remaining_sec: data.remaining_sec, game_state: data.game_state };
              if (data.actual_imposter) st.actual_imposter = data.actual_imposter;
              if (data.is_timeout) st.is_timeout = data.is_timeout;
              updateStatus(st, { fromStart: true });
              if (restart) {
                clearGameLogPanelAndState();
                appendLog('System: Tartarus Protocol initialized.', false);
              } else if (data.events && data.events.length) {
                applyEvents(data.events);
              } else {
                appendLog('System: Tartarus Protocol initialized.', false);
              }
              startStatePolling();
            } else {
              appendLog('Error: ' + (data.error || 'unknown'), true);
            }
          })
          .catch(function(err) {
            appendLog('Connection failed. Start: node telegram/bot/bot.js', true);
          })
          .finally(function() {
            startRequestInFlight = false;
            setRestartButtonsDisabled(false);
            forceInvalidateUserActionLock();
          });
      }

      function doMessage(text) {
        if (isGameOver || userActionPending) return;
        var userTurnLockSeq = beginCaptainUserActionLock();
        var playerId = getPlayerId();
        logMiniappApiLang('/api/message');
        fetch(API_BASE + '/api/message', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ playerId: playerId, text: text, lang: getLangForApi() })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.ok) {
              var st = { remaining_sec: data.remaining_sec, game_state: data.match_state };
              if (data.actual_imposter) st.actual_imposter = data.actual_imposter;
              if (data.is_timeout) st.is_timeout = data.is_timeout;
              updateStatus(st, { forApiMessage: true });
              if (data.game_over) stopStatePolling();
              appendSummaryOrEvents(data);
            } else {
              appendLog('Error: ' + (data.error || 'unknown'), true);
            }
          })
          .catch(function(err) {
            appendLog('Connection failed: ' + err.message, true);
          })
          .finally(function() {
            scheduleTryReleaseUserActionAfterLogRender(userTurnLockSeq);
          });
      }

      /** 처형 ?�정 ?�용 ??/api/message·doMessage 경로 미사?? ?�스???�싱 ?�음 (?�래그는 confirmAccuse?�서 ?�설?? */
      function postAccuse(targetKey) {
        if (isGameOver) {
          accuseRequestInFlight = false;
          setAccuseConfirmDisabled(false);
          updateExecuteConfirmEnabled();
          return;
        }
        var playerId = getPlayerId();
        logMiniappApiLang('/api/accuse');
        fetch(API_BASE + '/api/accuse', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ playerId: playerId, target: targetKey, lang: getLangForApi() })
        })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data.ok) {
              var st = { remaining_sec: data.remaining_sec, game_state: data.match_state };
              if (data.actual_imposter) st.actual_imposter = data.actual_imposter;
              if (data.is_timeout) st.is_timeout = data.is_timeout;
              updateStatus(st, { forApiMessage: true });
              if (data.game_over) stopStatePolling();
              appendSummaryOrEvents(data);
            } else {
              appendLog('Error: ' + (data.error || 'unknown'), true);
            }
          })
          .catch(function(err) {
            appendLog('Connection failed: ' + err.message, true);
          })
          .finally(function() {
            accuseRequestInFlight = false;
            updateExecuteConfirmEnabled();
          });
      }

