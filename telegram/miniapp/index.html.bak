        <button type="button" class="modal-target-btn" data-target="doctor" id="target-doctor">?�터</button>
        <button type="button" class="modal-target-btn" data-target="engineer" id="target-engineer">?��??�어</button>
        <button type="button" class="modal-target-btn" data-target="navigator" id="target-navigator">?�비게이??/button>
        <button type="button" class="modal-target-btn" data-target="pilot" id="target-pilot">?�일??/button>
      </div>
      <div class="modal-actions">
