          engineer: 'Engineer',
          navigator: 'Navigator',
          pilot: 'Pilot'
        }
      };

      var VALID_ACCUSE_TARGETS = ['doctor', 'engineer', 'navigator', 'pilot'];

      const introScreen = document.getElementById('intro-screen');
      const introScrollLines = document.getElementById('intro-scroll-lines');
      const introScrollContent = document.getElementById('intro-scroll-content');
