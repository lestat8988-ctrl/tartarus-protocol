        <button type="button" class="modal-confirm" id="execute-confirm" disabled>?�정</button>
      </div>
    </div>
  </div>

  <!-- Threat target modal (비처???�협 ??/api/action threaten) -->
  <div class="modal-overlay" id="threat-modal">
    <div class="modal-box">
      <div class="modal-title" id="threat-modal-title">?�협 ?�???�택</div>
      <div class="modal-instruction" id="threat-modal-instruction">?�박???�무??1명을 ?�택?�십?�오. 처형???�닙?�다.</div>
      <div class="modal-execute-warn" id="threat-no-target-hint" role="status"></div>
      <div class="modal-targets">
        <button type="button" class="threat-target-btn" data-target="doctor" id="threat-target-doctor">?�터</button>
        <button type="button" class="threat-target-btn" data-target="engineer" id="threat-target-engineer">?��??�어</button>
        <button type="button" class="threat-target-btn" data-target="navigator" id="threat-target-navigator">?�비게이??/button>
        <button type="button" class="threat-target-btn" data-target="pilot" id="threat-target-pilot">?�일??/button>
