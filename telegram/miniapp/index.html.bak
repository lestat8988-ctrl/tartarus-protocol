  <script>
    (function() {
      /**
       * 공개 tunnel 주소가 바뀌면 ????줄만 ?�정?�면 ??
       * ?�선?�위: window.TELEGRAM_API_BASE > meta[name=telegram-api-base] > (?�이지가 localhost�? http://localhost:8788 > ???�수
       */
      var DEFAULT_PUBLIC_API_BASE = 'https://thirty-bats-wish.loca.lt';

      function trimApiBase(s) {
        if (s == null || s === '') return '';
        return String(s).trim().replace(/\/$/, '');
      }

      function resolveApiBase() {
        try {
          if (typeof window !== 'undefined' && window.TELEGRAM_API_BASE) {
            var wb = trimApiBase(window.TELEGRAM_API_BASE);
            if (wb) return wb;
          }
        } catch (e0) {}
        try {
          var meta = document.querySelector('meta[name="telegram-api-base"]');
          if (meta) {
            var mc = trimApiBase(meta.getAttribute('content'));
            if (mc) return mc;
          }
        } catch (e1) {}
        try {
          var h = location.hostname || '';
          if (h === 'localhost' || h === '127.0.0.1' || h === '[::1]') {
            return 'http://localhost:8788';
          }
        } catch (e2) {}
        var fb = trimApiBase(DEFAULT_PUBLIC_API_BASE);
        return fb || 'http://localhost:8788';
      }

      var API_BASE = resolveApiBase();
      try { console.log('[miniapp] apiBase=' + API_BASE); } catch (e) {}

      const PLAYER_KEY = 'tartarus_miniapp_playerId';
      const LANG_KEY = 'tartarus_miniapp_lang';

      var screen = 'intro';
      var storedLang;
      try { storedLang = (localStorage.getItem(LANG_KEY) || '').trim(); } catch (e) { storedLang = ''; }
      var lang = (storedLang === 'ko' || storedLang === 'en') ? storedLang : 'en';

      function getLangForApi() {
        return (lang === 'ko' || lang === 'en') ? lang : 'en';
