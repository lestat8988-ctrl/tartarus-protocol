      const introLangKo = document.getElementById('intro-lang-ko');
      const introLangEn = document.getElementById('intro-lang-en');
      const gameScreen = document.getElementById('game-screen');
      const hudCountdown = document.getElementById('hud-countdown');
      const briefingBootTitle = document.getElementById('briefing-boot-title');
      const briefingTargetVessel = document.getElementById('briefing-target-vessel');
      const briefingMission = document.getElementById('briefing-mission');
      const briefingLocation = document.getElementById('briefing-location');
      const briefingHadesTitle = document.getElementById('briefing-hades-title');
      const briefingHades1 = document.getElementById('briefing-hades-1');
      const briefingHades2 = document.getElementById('briefing-hades-2');
      const briefingHades3 = document.getElementById('briefing-hades-3');
      const briefingHades4 = document.getElementById('briefing-hades-4');
