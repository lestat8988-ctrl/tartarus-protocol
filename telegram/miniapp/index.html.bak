<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <!-- ?�택: 공개 bot API base (비우�??�크립트??DEFAULT_PUBLIC_API_BASE ???�용) -->
  <meta name="telegram-api-base" content="" />
  <title>Tartarus Protocol - Mini App</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; }
    :root {
      --captain-status-color-idle: #2aef2a;
      --captain-status-color-pending: #5eff5e;
      --captain-status-font-size: 0.78rem;
      --captain-status-letter-spacing: 0.04em;
      --captain-status-min-height: 1.35em;

      /*
       * Game log + 붕괴 ?�?�머 ????블록�??�정??롤백/?�닝.
       * --role-* : ?�더/강조, --role-*-body : 본문·?�레?�션·?�속 �??�일 블록).
       * ?�단 "?�선 붕괴까�?" (#game-screen .subheader)??--role-system �??�일.
       */
      --role-captain: #e4e4e4;
      --role-captain-body: #b0b0b0;
      --role-captain-border: rgba(228, 228, 228, 0.42);
      --role-doctor: #e8a882;
      --role-doctor-body: #c69672;
      --role-doctor-border: rgba(232, 168, 130, 0.45);
      --role-engineer: #d8a8d4;
      --role-engineer-body: #a888ad;
      --role-engineer-border: rgba(216, 168, 212, 0.45);
      --role-navigator: #f2a8d8;
      --role-navigator-body: #ca90b4;
      --role-navigator-border: rgba(242, 168, 216, 0.42);
      --role-pilot: #5edcc4;
      --role-pilot-body: #48b8a4;
      --role-pilot-border: rgba(94, 220, 196, 0.45);
      --role-system: #ff5050;
      --role-system-body: #ff6b6b;
      --role-system-border: rgba(255, 80, 80, 0.6);
    }
    body {
      background: #0a0a0a;
      color: #2aef2a;
      font-family: 'Courier New', Courier, monospace;
      font-size: 14px;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    /* 처형 모달 ?�림: ?�래 게임 UI�??�치가 ?��? ?�게 (고스???�릭?�로 ?�송 버튼·?�전 ?�력 ?�전??방�?) */
    body.execute-modal-open #game-screen,
    body.threat-modal-open #game-screen,
    body.question-modal-open #game-screen {
      pointer-events: none;
    }
    #app {
      min-height: 100vh;
      max-width: 480px;
      margin: 0 auto;
      padding: 12px;
      padding-bottom: 24px;
    }

    /* Header (베르?� game-header ?��??? ?�?��? + ?�?�머�? */
    .header {
      text-align: center;
      padding: 6px 0 8px;
      border-bottom: 1px solid #2aef2a33;
      margin-bottom: 6px;
    }
    .header h1 {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 1px;
    }
    .subheader {
      margin-top: 2px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    #game-screen .subheader {
      color: var(--role-system);
      text-shadow: 0 0 10px rgba(255, 80, 80, 0.45);
    }

    /* Outcome badge (game over) */
    .outcome-badge {
      margin: 8px 0 12px;
      padding: 10px 14px;
      text-align: center;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 1px;
      border-radius: 4px;
      display: none;
    }
    .outcome-badge.visible { display: block; }
    .outcome-badge.crew_win { background: #0a3a0a; border: 2px solid #2aef2a; color: #4aff4a; box-shadow: 0 0 12px rgba(42,239,42,0.3); }
    .outcome-badge.impostor_win { background: #3a0a0a; border: 2px solid #ef2a2a; color: #ff4a4a; box-shadow: 0 0 12px rgba(239,42,42,0.3); }
    .outcome-badge.accuse_failed { background: #3a1a0a; border: 2px solid #ef8a2a; color: #ffaa4a; box-shadow: 0 0 12px rgba(239,138,42,0.25); }

    /* ?�장 ?�력 / ?�루 ?�답 ?�태 (public index phase-status?� ?�일 ??��, ?�일 ?�래그로�?갱신) */
    .captain-phase-status {
      display: block;
      text-align: center;
      font-size: var(--captain-status-font-size);
      letter-spacing: var(--captain-status-letter-spacing);
      min-height: var(--captain-status-min-height);
      margin: 4px 0 8px;
      padding: 6px 8px;
      border-radius: 4px;
      border: 1px solid transparent;
      transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
    }
    .captain-phase-status.captain-phase-idle {
      color: var(--captain-status-color-idle);
      background: #0d1a0d;
      border-color: #2aef2a33;
    }
    .captain-phase-status.captain-phase-pending {
      color: var(--captain-status-color-pending);
      background: #0f2210;
      border-color: #2aef2a55;
      font-weight: 600;
    }
    .captain-phase-status.captain-phase-hidden {
      display: none;
    }
    body.crew-response-pending #game-screen .input-area input {
      opacity: 0.45;
    }

    /* Status card ???�레??�??��? (베르?�처럼 로그 중심) */
    .status-card {
      display: none;
    }

    /* Log panel (베르?� #log ?��??? 메인 ?��????�역 ?��?) */
    .log-panel {
      min-height: 200px;
      max-height: 320px;
      overflow-y: auto;
      overflow-x: hidden;
      padding: 8px 10px;
      margin: 6px 0;
      background: #0d0d0d;
      border: 1px solid #2aef2a22;
      border-radius: 4px;
      font-size: 0.8rem;
      -webkit-overflow-scrolling: touch;
    }
    .log-entry {
      margin-bottom: 6px;
      padding-left: 8px;
      border-left: 2px solid #2aef2a44;
    }
    .log-entry.error { border-color: #ef2a2a44; }

    /* Game log only: 블록 기본??= 본문 계열(?�속 줄�? text ?�드�??�어???�일 ?? */
    #game-screen .log-panel .log-entry[data-role="captain"] { border-left-color: var(--role-captain-border); color: var(--role-captain-body); }
    #game-screen .log-panel .log-entry[data-role="captain"] .log-role-header { color: var(--role-captain); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="captain"] .log-role-body { color: var(--role-captain-body); }
    #game-screen .log-panel .log-entry[data-role="doctor"] { border-left-color: var(--role-doctor-border); color: var(--role-doctor-body); }
    #game-screen .log-panel .log-entry[data-role="doctor"] .log-role-header { color: var(--role-doctor); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="doctor"] .log-role-body { color: var(--role-doctor-body); }
    #game-screen .log-panel .log-entry[data-role="engineer"] { border-left-color: var(--role-engineer-border); color: var(--role-engineer-body); }
    #game-screen .log-panel .log-entry[data-role="engineer"] .log-role-header { color: var(--role-engineer); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="engineer"] .log-role-body { color: var(--role-engineer-body); }
    #game-screen .log-panel .log-entry[data-role="navigator"] { border-left-color: var(--role-navigator-border); color: var(--role-navigator-body); }
    #game-screen .log-panel .log-entry[data-role="navigator"] .log-role-header { color: var(--role-navigator); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="navigator"] .log-role-body { color: var(--role-navigator-body); }
    #game-screen .log-panel .log-entry[data-role="pilot"] { border-left-color: var(--role-pilot-border); color: var(--role-pilot-body); }
    #game-screen .log-panel .log-entry[data-role="pilot"] .log-role-header { color: var(--role-pilot); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="pilot"] .log-role-body { color: var(--role-pilot-body); }
    #game-screen .log-panel .log-entry[data-role="system"] { border-left-color: var(--role-system-border); color: var(--role-system-body); }
    #game-screen .log-panel .log-entry[data-role="system"] .log-role-header { color: var(--role-system); font-weight: 600; }
    #game-screen .log-panel .log-entry[data-role="system"] .log-role-body { color: var(--role-system-body); }

    /* Action buttons (2??배치 ?��?) */
    .action-panel {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 6px 8px;
      margin: 6px 0;
    }
    .action-btn {
      padding: 12px;
      background: #111;
      border: 1px solid #2aef2a55;
      border-radius: 4px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 0.85rem;
      cursor: pointer;
      text-align: center;
      -webkit-tap-highlight-color: transparent;
    }
    .action-btn:active { background: #1a2a1a; }
    .action-btn.locked {
      opacity: 0.4;
      cursor: not-allowed;
      pointer-events: none;
      border-color: #2aef2a22;
      color: #2aef2a66;
    }
    @media (max-width: 360px) {
      .action-panel { grid-template-columns: 1fr; }
    }

    /* Input area */
    .input-area {
      display: flex;
      gap: 8px;
      margin: 6px 0;
      padding-bottom: 8px;
    }
    .input-area input {
      flex: 1;
      padding: 14px 12px;
      background: #111;
      border: 1px solid #2aef2a55;
      border-radius: 4px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 0.9rem;
    }
    .input-area input::placeholder { color: #2aef2a44; }
    .input-area button {
      padding: 14px 18px;
      background: #1a3a1a;
      border: 1px solid #2aef2a;
      border-radius: 4px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      -webkit-tap-highlight-color: transparent;
    }
    .input-area button:active { background: #2a4a2a; }
    .input-area.disabled input,
    .input-area.disabled button {
      opacity: 0.4;
      cursor: not-allowed;
      pointer-events: none;
      border-color: #2aef2a22;
    }
    .input-area.disabled input { color: #2aef2a66; }
    .input-area.disabled input::placeholder { color: #2aef2a44; }

    /* Restart button (game over only) */
    .restart-section {
      display: none;
      margin: 16px 0 24px;
      padding: 12px 0;
    }
    .restart-section.visible { display: block; }
    .restart-btn {
      width: 100%;
      padding: 16px 20px;
      background: linear-gradient(180deg, #1a4a1a 0%, #0d2a0d 100%);
      border: 1px solid #2aef2a;
      border-radius: 6px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .restart-btn:active { background: #2a5a2a; }

    @media (max-width: 480px) {
      .action-panel { gap: 10px; margin: 14px 0; }
      .action-btn { padding: 14px; min-height: 48px; }
      .input-area { gap: 10px; margin: 14px 0; }
      .restart-section { margin: 18px 0 28px; }
      .restart-btn { padding: 18px 24px; min-height: 52px; }
    }

    /* Episode lock section */
    .episode-section {
      padding: 8px 10px;
      margin-top: 8px;
      background: #0d0d0d;
      border: 1px solid #2aef2a22;
      border-radius: 4px;
    }
    .episode-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      font-size: 0.85rem;
    }
    .episode-row.locked { color: #666; opacity: 0.8; }
    .episode-row.available { color: #2aef2a; }
    .episode-unlock-btn {
      width: 100%;
      margin-top: 12px;
      padding: 14px;
      background: #1a1a1a;
      border: 1px dashed #2aef2a55;
      border-radius: 4px;
      color: #2aef2a99;
      font-family: inherit;
      font-size: 0.9rem;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .episode-unlock-btn:active { background: #222; }

    /* Intro screen (public/index.html #intro-briefing 기�?) */
    #intro-screen {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: flex;
      flex-direction: column;
      background: #000 url(./assets/tartarus-ship-neptune.png) center center no-repeat;
      background-size: clamp(320px, 70vw, 900px) auto;
      background-position: center 45%;
      padding: 0;
      overflow: hidden;
    }
    #intro-screen::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;
      background: repeating-linear-gradient(0deg, rgba(0,0,0,0.05) 0px, transparent 1px, transparent 3px);
    }
    #intro-screen::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 6;
      pointer-events: none;
      background:
        linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.5) 30%, rgba(0,0,0,0.55) 65%, rgba(0,0,0,0.9) 100%),
        radial-gradient(ellipse 85% 85% at 50% 50%, transparent 45%, rgba(0,0,0,0.4) 100%);
    }
    #intro-screen .intro-bottom { position: relative; z-index: 20; }
    #intro-screen.hidden { display: none; }
    #intro-scroll-wrapper {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      position: relative;
      z-index: 8;
    }
    #intro-scroll-content {
      position: absolute;
      left: 50%;
      top: 0;
      transform: translateX(-50%) translateY(0);
      width: 100%;
      max-width: 440px;
      padding: 24px 20px 80px;
      padding-top: max(24px, env(safe-area-inset-top, 0px) + 12px);
      text-align: center;
    }
    #intro-scroll-title {
      font-size: 18px;
      letter-spacing: 6px;
      color: #2aef2a;
      text-shadow: 0 0 2px rgba(42,239,42,0.5);
      margin-bottom: 24px;
    }
    #intro-scroll-subtitle {
      font-size: 12px;
      letter-spacing: 2px;
      color: rgba(42,239,42,0.9);
      text-shadow: 0 0 1px rgba(42,239,42,0.4);
      margin-bottom: 28px;
      line-height: 1.8;
    }
    #intro-scroll-content.scroll-animate {
      animation: introCreditsScroll 85s linear 5s 1 forwards;
    }
    @keyframes introCreditsScroll {
      0% { transform: translateX(-50%) translateY(0); }
      100% { transform: translateX(-50%) translateY(-100%); }
    }
    .intro-scroll-lines .lore-line { margin-bottom: 10px; color: #2aef2a; }
    .intro-scroll-lines .lore-spacer { height: 16px; margin-bottom: 16px; }
    .intro-scroll-lines .lore-alert { font-weight: 600; color: #2aef2a; }
    .intro-scroll-lines .lore-section-title { font-weight: 600; color: #2aef2a; margin-top: 8px; }
    .intro-scroll-lines {
      font-size: 0.9rem;
      line-height: 1.9;
      color: #2aef2a;
    }
    .intro-bottom {
      flex-shrink: 0;
      margin-top: auto;
      padding: 20px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      position: relative;
      z-index: 20;
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.85) 25%);
    }
    .intro-init-btn {
      padding: 16px 28px;
      background: #0d2a0d;
      border: 2px solid #2aef2a;
      border-radius: 6px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 2px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .intro-init-btn:active { background: #1a3a1a; }
    .intro-lang-row { display: flex; gap: 12px; }
    .intro-lang-btn {
      padding: 8px 16px;
      background: transparent;
      border: 1px solid #2aef2a55;
      border-radius: 4px;
      color: #2aef2a99;
      font-family: inherit;
      font-size: 0.85rem;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .intro-lang-btn.active { border-color: #2aef2a; color: #2aef2a; background: #1a2a1a; }
    .intro-lang-btn:active { background: #1a2a1a; }

    /* Intro 모바??(public @media max-width: 768px 기�?) */
    @media (max-width: 768px) {
      #intro-screen {
        background-size: contain;
        background-position: center 35%;
      }
      #intro-scroll-content {
        padding: 16px 16px 80px;
        padding-top: max(16px, env(safe-area-inset-top, 0px) + 8px);
      }
      #intro-scroll-title {
        font-size: 14px;
        letter-spacing: 3px;
        margin-bottom: 16px;
        text-shadow: 0 0 1px rgba(42,239,42,0.35);
      }
      #intro-scroll-subtitle {
        font-size: 11px;
        margin-bottom: 20px;
        text-shadow: 0 0 1px rgba(42,239,42,0.3);
      }
      .intro-bottom {
        padding: 12px 16px max(16px, env(safe-area-inset-bottom, 0px));
      }
    }

    /* Game screen (visible after init) */
    #game-screen { display: none; min-height: 100vh; }
    #game-screen.visible { display: block; }

    /* 게임 브리???�크�?(베르?�???�로 ?�르??briefing) */
    .game-briefing-viewport {
      height: 140px;
      margin: 6px 0 0;
      overflow: hidden;
      background: #0d0d0d;
      border: 1px solid #2aef2a22;
      border-radius: 4px;
      transition: height 0.4s ease, margin 0.4s ease, padding 0.4s ease, opacity 0.3s ease;
    }
    .game-briefing-viewport.collapsed {
      height: 0;
      margin: 0;
      padding: 0;
      border-width: 0;
      opacity: 0;
      overflow: hidden;
    }
    .game-briefing-scroll {
      padding: 12px 14px 24px;
      font-size: 0.78rem;
      line-height: 1.6;
      color: #2aef2a99;
    }
    .game-briefing-scroll.scroll-animate {
      animation: gameBriefingScroll 28s linear 1s 1 forwards;
    }
    @keyframes gameBriefingScroll {
      0% { transform: translateY(0); }
      100% { transform: translateY(-100%); }
    }
    .game-briefing-line {
      margin-bottom: 6px;
    }
    .game-briefing-line.briefing-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: #2aef2a;
      letter-spacing: 1px;
      margin-top: 10px;
      margin-bottom: 4px;
    }
    .game-briefing-line.briefing-title:first-child { margin-top: 0; }

    /* Execute protocol modal */
    .modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.85);
      padding: 16px;
    }
    .modal-overlay.visible { display: flex; }
    .modal-box {
      width: 100%;
      max-width: 360px;
      background: #111;
      border: 1px solid #2aef2a55;
      border-radius: 8px;
      padding: 20px;
    }
    .modal-title { font-size: 1rem; font-weight: 600; color: #2aef2a; margin-bottom: 8px; text-align: center; }
    .modal-instruction { font-size: 0.8rem; color: #2aef2a99; margin-bottom: 16px; text-align: center; line-height: 1.4; }
    .modal-execute-warn { display: none; font-size: 0.78rem; color: #e6a23c; text-align: center; margin: -8px 0 12px; line-height: 1.35; }
    .modal-execute-warn.visible { display: block; }
    .modal-targets { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 20px; }
    .modal-target-btn,
    .threat-target-btn,
    .question-target-btn {
      padding: 14px;
      background: #1a1a1a;
      border: 1px solid #2aef2a55;
      border-radius: 4px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 0.9rem;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .modal-target-btn.selected,
    .threat-target-btn.selected,
    .question-target-btn.selected { border-color: #2aef2a; background: #1a3a1a; }
    .modal-target-btn.dead,
    .threat-target-btn.dead,
    .question-target-btn.dead,
    .modal-target-btn:disabled,
    .threat-target-btn:disabled,
    .question-target-btn:disabled {
      opacity: 0.42;
      cursor: not-allowed;
      border-color: #444;
      color: #666;
      background: #141414;
      box-shadow: none;
    }
    .modal-target-btn.dead.selected,
    .threat-target-btn.dead.selected,
    .question-target-btn.dead.selected { border-color: #444; background: #141414; color: #666; }
    .modal-target-btn:active:not(:disabled),
    .threat-target-btn:active:not(:disabled),
    .question-target-btn:active:not(:disabled) { background: #222; }
    .modal-actions { display: flex; gap: 10px; }
    .modal-actions button {
      flex: 1;
      padding: 14px;
      border-radius: 4px;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .modal-cancel { background: #333; border: 1px solid #666; color: #ccc; }
    .modal-confirm { background: #1a3a1a; border: 1px solid #2aef2a; color: #2aef2a; }
    #restart-btn:disabled,
    #result-restart-btn:disabled,
    #execute-confirm:disabled,
    #threat-confirm:disabled,
    #question-confirm:disabled {
      opacity: 0.45;
      cursor: not-allowed;
      pointer-events: none;
    }
    @media (max-width: 480px) {
      .modal-box { padding: 24px; }
      .modal-target-btn,
      .threat-target-btn,
      .question-target-btn { padding: 16px; min-height: 48px; }
    }

    /* Result modal (game over) */
    #result-modal .result-modal-box { border-color: #2aef2a55; }
    #result-modal.result-win .result-modal-box { border-color: #2aef2a; }
    #result-modal.result-lose .result-modal-box { border-color: #ef2a2a; }
    .result-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 12px; text-align: center; }
    .result-win .result-title { color: #4aff4a; }
    .result-lose .result-title { color: #ff4a4a; }
    .result-desc { font-size: 0.88rem; color: #2aef2a99; margin-bottom: 12px; line-height: 1.5; }
    .result-outcome-row { font-size: 0.85rem; margin-bottom: 10px; }
    .result-outcome-label { color: #2aef2a99; margin-right: 6px; }
    .result-imposter { font-size: 0.9rem; margin-bottom: 8px; }
    .result-dead { font-size: 0.85rem; color: #ef2a2a99; margin-bottom: 16px; line-height: 1.4; }
    .result-dead-label { color: #2aef2a99; }
    .result-restart-btn {
      width: 100%;
      padding: 14px;
      background: #1a3a1a;
      border: 1px solid #2aef2a;
      border-radius: 4px;
      color: #2aef2a;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
  </style>
</head>
<body>
  <div id="app">
    <!-- Intro screen -->
    <div id="intro-screen">
      <div id="intro-scroll-wrapper">
        <div id="intro-scroll-content" class="scroll-animate">
          <div id="intro-scroll-title">TARTARUS PROTOCOL</div>
          <div id="intro-scroll-subtitle">USS C TARTARUS<br>2198 / NEPTUNE OUTER ORBIT</div>
          <div class="intro-scroll-lines" id="intro-scroll-lines"></div>
        </div>
      </div>
      <div class="intro-bottom">
        <button type="button" class="intro-init-btn" id="intro-init-btn">[ SYSTEM INITIALIZE ]</button>
        <div class="intro-lang-row">
          <button type="button" class="intro-lang-btn" id="intro-lang-ko" data-lang="ko">?�국??/button>
          <button type="button" class="intro-lang-btn active" id="intro-lang-en" data-lang="en">ENGLISH</button>
        </div>
      </div>
    </div>

    <!-- Game screen -->
    <div id="game-screen">
    <header class="header">
      <h1>Tartarus Protocol</h1>
      <p class="subheader" id="hud-countdown">TIME UNTIL TOTAL SHIP COLLAPSE : --:--</p>
    </header>

    <div class="outcome-badge" id="outcome-badge"></div>

    <p id="captain-phase-status" class="captain-phase-status captain-phase-idle" role="status" aria-live="polite"></p>

    <section class="game-briefing-viewport" id="game-briefing-viewport">
      <div class="game-briefing-scroll" id="game-briefing-scroll">
        <div class="game-briefing-line briefing-title" id="briefing-boot-title">[SYSTEM INITIALIZE??</div>
        <div class="game-briefing-line" id="briefing-target-vessel">Target vessel: USSC Tartarus (Prototype)</div>
        <div class="game-briefing-line" id="briefing-mission">Mission: PROJECT 'HORIZON' - Gravity Drive Test</div>
        <div class="game-briefing-line" id="briefing-location">Location: Neptune Orbit (Edge of Solar System)</div>
        <div class="game-briefing-line briefing-title" id="briefing-hades-title">[HADES ALERT]</div>
        <div class="game-briefing-line" id="briefing-hades-1">The gravity drive awakened the unauthorized layer known as HADES.</div>
        <div class="game-briefing-line" id="briefing-hades-2">A parasitic overlap entity slipped into the return signal.</div>
        <div class="game-briefing-line" id="briefing-hades-3">The four crew members are scattered across the ship, each carrying out their own duties.</div>
        <div class="game-briefing-line" id="briefing-hades-4">Communications are open, but none of them are standing together.</div>
        <div class="game-briefing-line briefing-title" id="briefing-objectives-title">[PRIMARY OBJECTIVES]</div>
        <div class="game-briefing-line" id="briefing-obj-1">1. Identify the HOST hidden among the four crew members.</div>
        <div class="game-briefing-line" id="briefing-obj-2">2. Eliminate the overlap entity before time runs out.</div>
        <div class="game-briefing-line" id="briefing-obj-3">3. If you fail, it will isolate and kill the crew one by one.</div>
      </div>
    </section>

    <section class="status-card">
      <div class="status-item full-width">
        <span id="label-match-id">Match ID</span>
        <div class="status-value match-id" id="status-match-id" title="">--</div>
      </div>
      <div class="status-item">
        <span id="label-remaining">Remaining Time</span>
        <div class="status-value" id="status-time">--:--</div>
      </div>
      <div class="status-item">
        <span id="label-location">Current Location</span>
        <div class="status-value" id="status-location">Bridge</div>
      </div>
      <div class="status-item">
        <span id="label-threat">Threat Level</span>
        <div class="status-value" id="status-threat">NOMINAL</div>
      </div>
      <div class="status-item full-width" id="status-outcome-wrap" style="display:none;">
        <span id="label-outcome">Outcome</span>
        <div class="status-value" id="status-outcome">--</div>
      </div>
      <div class="status-item full-width" id="status-dead-wrap" style="display:none;">
        <span id="label-dead">Dead Roles</span>
        <div class="status-value" id="status-dead">--</div>
      </div>
    </section>

    <section class="log-panel" id="log-panel">
      <div class="log-entry" id="log-init">[--] Connecting...</div>
    </section>

    <section class="action-panel" id="action-panel">
      <button class="action-btn" data-action="question">?�무???�문</button>
      <button class="action-btn" data-action="cctv">CCTV 로그 ?�인</button>
      <button class="action-btn" data-action="engine">?�진???�인</button>
      <button class="action-btn" data-action="pistol">권총 ?�득</button>
      <button class="action-btn" data-action="threat">?�협</button>
      <button class="action-btn" data-action="clue">?�서 ?�집</button>
      <button class="action-btn" data-action="execute" style="grid-column: 1 / -1;">처형 ?�로?�콜 ?�행</button>
    </section>

    <section class="input-area" id="input-area">
      <input type="text" id="free-input" placeholder="?�유 ?�력..." maxlength="200" />
      <button type="button" id="send-btn">?�송</button>
    </section>

    <section class="restart-section" id="restart-section">
      <button type="button" class="restart-btn" id="restart-btn">??매치 ?�작</button>
    </section>

    <section class="episode-section">
      <div class="episode-row available">Episode 1: Free / Available</div>
      <div class="episode-row locked">Episode 2: Locked</div>
      <div class="episode-row locked">Episode 3: Locked</div>
      <button class="episode-unlock-btn" id="episode-unlock-btn">Unlock Episode Pass</button>
    </section>
    </div><!-- #game-screen -->
  </div>

  <!-- Result modal (game over) -->
  <div class="modal-overlay" id="result-modal">
    <div class="modal-box result-modal-box">
      <div class="result-title" id="result-title">--</div>
      <div class="result-desc" id="result-desc">--</div>
      <div class="result-outcome-row" id="result-outcome-row" style="display:none;"><span class="result-outcome-label" id="result-outcome-label">--</span><span id="result-outcome-value">--</span></div>
      <div class="result-imposter" id="result-imposter" style="display:none;"></div>
      <div class="result-dead" id="result-dead" style="display:none;"></div>
      <button type="button" class="result-restart-btn" id="result-restart-btn">?�시 ?�작</button>
    </div>
  </div>

  <!-- Execute protocol modal -->
  <div class="modal-overlay" id="execute-modal">
    <div class="modal-box">
      <div class="modal-title" id="execute-modal-title">처형 ?�???�택</div>
      <div class="modal-instruction" id="execute-modal-instruction">처형 ?�??1명을 ?�택?�십?�오. ?�환?� 1발뿐?�니??</div>
      <div class="modal-execute-warn" id="execute-no-target-hint" role="status"></div>
